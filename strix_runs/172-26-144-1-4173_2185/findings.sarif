            {
              "id": "CWE-862",
              "name": "Row Level Security (RLS) Bypass / Missing Authorization in Supabase `bookings` API",
              "shortDescription": {
                "text": "Row Level Security (RLS) Bypass / Missing Authorization in Supabase `bookings` API"
              },
              "fullDescription": {
                "text": "The Supabase API endpoint `/rest/v1/bookings` is not protected by Row Level Security (RLS), allowing an authenticated user to access all booking records, including those belonging to other customers or studios."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "The Supabase API endpoint `/rest/v1/bookings` is not protected by Row Level Security (RLS), allowing an authenticated user to access all booking records, including those belonging to other customers or studios.\n\nUnauthorized access to all booking records, including PII such as customer names, emails, phone numbers, and booking details.\n\nEnable Row Level Security (RLS) on the `bookings` table in Supabase and define policies that restrict access to records belonging to the authenticated user's organization/studio.",
                "markdown": "The Supabase API endpoint `/rest/v1/bookings` is not protected by Row Level Security (RLS), allowing an authenticated user to access all booking records, including those belonging to other customers or studios.\n\nUnauthorized access to all booking records, including PII such as customer names, emails, phone numbers, and booking details.\n\nEnable Row Level Security (RLS) on the `bookings` table in Supabase and define policies that restrict access to records belonging to the authenticated user's organization/studio."
              },
              "properties": {
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "CWE-862",
                  "stride:E"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/862.html"
            },
